<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lớp Toán Thầy Đài - Đề Ôn Tập KTGKI 04 (Toán 11)</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyberBg: '#0b1120',
                        cyberHeader: '#0f172a',
                        cyberPanel: '#131c31',
                        cyberCard: '#1a253d',
                        cyberBorder: '#263554',
                        cyberAccent: '#f59e0b',
                        cyberPrimary: '#6366f1',
                        cyberPurple: '#a855f7'
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- KaTeX for Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

    <style>
        body {
            background-color: #0b1120;
            color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        body.theme-light {
            background-color: #f1f5f9;
            color: #0f172a;
        }
        body.theme-light .cyber-panel {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }
        body.theme-light .cyber-card {
            background-color: #f8fafc !important;
            border-color: #e2e8f0 !important;
            color: #1e293b !important;
        }
        body.theme-light .cyber-header {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b1120; 
        }
        ::-webkit-scrollbar-thumb {
            background: #263554; 
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569; 
        }

        /* Math Data Tables */
        .math-table {
            width: 100%;
            border-collapse: collapse;
            margin: 14px 0;
            font-size: 0.95rem;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #334155;
        }
        .math-table th, .math-table td {
            border: 1px solid #334155;
            padding: 10px 12px;
            text-align: center;
        }
        .math-table th {
            background-color: rgba(99, 102, 241, 0.15);
            font-weight: 600;
            color: #c7d2fe;
        }
        .math-table td {
            background-color: rgba(15, 23, 42, 0.6);
        }

        /* Option selection styling */
        .mcq-item.selected {
            border-color: #6366f1 !important;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.12)) !important;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.25);
        }
        .mcq-item.selected .mcq-badge {
            background-color: #6366f1 !important;
            color: #ffffff !important;
            border-color: #818cf8 !important;
        }
        .mcq-item.correct-review {
            border-color: #10b981 !important;
            background: rgba(16, 185, 129, 0.15) !important;
        }
        .mcq-item.wrong-review {
            border-color: #ef4444 !important;
            background: rgba(239, 68, 68, 0.15) !important;
        }

        /* Question Palette Buttons */
        .palette-btn {
            transition: all 0.18s ease;
        }
        .palette-btn.current {
            border-color: #818cf8 !important;
            background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
            color: white !important;
            transform: scale(1.06);
            box-shadow: 0 0 12px rgba(99, 102, 241, 0.5);
        }
        .palette-btn.answered:not(.current) {
            border-color: #10b981 !important;
            background-color: rgba(16, 185, 129, 0.15) !important;
            color: #34d399 !important;
        }

        /* Glow effects matching screenshot */
        .logo-box {
            background: linear-gradient(135deg, #312e81 0%, #581c87 100%);
            border: 1px solid #8b5cf6;
            box-shadow: 0 0 12px rgba(139, 92, 246, 0.4);
        }
        .btn-submit-gold {
            background: linear-gradient(135deg, #45270d 0%, #78350f 100%);
            border: 1px solid #d97706;
            color: #fcd34d;
        }
        .btn-submit-gold:hover {
            background: linear-gradient(135deg, #78350f 0%, #92400e 100%);
            box-shadow: 0 0 14px rgba(245, 158, 11, 0.35);
        }
    </style>
</head>
<body class="h-screen flex flex-col select-none">

    <!-- ==================== TOP HEADER (LIKE SCREENSHOT) ==================== -->
    <header class="cyber-header bg-[#0d1425] border-b border-slate-800/90 px-4 lg:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 shrink-0 z-20">
        <!-- Left Brand & Title -->
        <div class="flex items-center space-x-3.5">
            <div class="logo-box w-11 h-11 rounded-xl flex flex-col items-center justify-center shrink-0">
                <span class="text-xs font-extrabold tracking-tighter text-pink-400 leading-none">TĐ</span>
                <span class="text-[9px] font-bold text-indigo-200 tracking-widest mt-0.5">MATH</span>
            </div>
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-sm md:text-base font-extrabold tracking-wide bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent uppercase">
                        LỚP TOÁN THẦY ĐÀI
                    </h1>
                    <span class="text-xs font-medium bg-teal-950/90 text-teal-300 border border-teal-700/70 px-2.5 py-0.5 rounded-full">
                        Đề ôn tập KTGKI - Đề 04 (2026-2027)
                    </span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-[11px] text-slate-400 mt-0.5">
                    <span class="text-rose-400 font-medium"><i class="fa-solid fa-user-graduate mr-1"></i>Thí sinh: <strong id="header-student-name" class="text-white">Chưa đăng nhập</strong></span>
                    <span>|</span>
                    <span>Lớp: <strong id="header-student-class" class="text-amber-300">--</strong></span>
                    <span class="hidden sm:inline">•</span>
                    <span class="hidden sm:inline text-emerald-400 font-semibold">Môn: Toán 11 (45 phút)</span>
                </div>
            </div>
        </div>

        <!-- Center Countdown Timer -->
        <div class="flex items-center bg-[#131c31] border border-slate-700/80 rounded-xl px-4 py-1.5 shadow-inner">
            <i class="fa-regular fa-clock text-amber-400 mr-2.5 text-sm animate-pulse"></i>
            <div class="flex flex-col">
                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-bold leading-none">Thời gian còn lại</span>
                <span id="timer-display" class="text-base md:text-lg font-extrabold text-amber-400 tracking-wider leading-tight font-mono">45:00</span>
            </div>
        </div>

        <!-- Right Action Buttons -->
        <div class="flex items-center space-x-2">
            <!-- Theme switcher -->
            <button onclick="toggleTheme()" class="bg-[#162038] hover:bg-slate-800 text-slate-200 border border-slate-700 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition">
                <i class="fa-solid fa-moon text-indigo-400"></i>
                <span id="theme-label">Cyber</span>
                <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 ml-0.5"></i>
            </button>

            <!-- Submit Exam Button -->
            <button id="btn-header-submit" onclick="openSubmitConfirmModal()" class="btn-submit-gold px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition">
                <i class="fa-solid fa-award text-amber-400"></i>
                <span>Nộp Bài / Báo Điểm</span>
            </button>

            <!-- Toggle Solution Button -->
            <button id="btn-toggle-solution" onclick="handleSolutionClick()" class="bg-[#162038] hover:bg-slate-800 text-slate-300 border border-slate-700 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition">
                <i id="solution-lock-icon" class="fa-solid fa-lock text-amber-400"></i>
                <span>Mở lời giải</span>
            </button>

            <!-- Teacher Dashboard Button -->
            <button onclick="openTeacherDashboard()" class="bg-indigo-950/90 hover:bg-indigo-900 text-indigo-200 border border-indigo-700/80 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition" title="Danh sách học sinh đã làm bài">
                <i class="fa-solid fa-users-viewfinder text-indigo-400"></i>
                <span class="hidden md:inline">DS Nộp bài</span>
                <span id="submission-count-badge" class="bg-indigo-600 text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
        </div>
    </header>

    <!-- ==================== MAIN TWO-COLUMN WORKSPACE ==================== -->
    <main class="flex-1 overflow-y-auto lg:overflow-hidden p-4 lg:p-6">
        <div class="max-w-[1440px] mx-auto h-full flex flex-col lg:flex-row gap-6">
            
            <!-- LEFT COLUMN: QUESTION CONTENT (Matches Screenshot Card Style) -->
            <section class="cyber-panel flex-1 bg-[#11192c] border border-slate-800/90 rounded-2xl p-5 lg:p-7 flex flex-col overflow-y-auto shadow-2xl">
                <!-- Top Question Title & Part Info -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-800">
                    <div class="flex items-center gap-3">
                        <h2 id="q-number-title" class="text-xl lg:text-2xl font-extrabold text-white tracking-tight">Câu 1</h2>
                        <span id="q-part-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-950 text-indigo-300 border border-indigo-700/60">
                            PHẦN I • Trắc nghiệm 4 lựa chọn (0.5 điểm)
                        </span>
                    </div>
                    <span id="q-status-badge" class="text-xs font-medium text-slate-400">
                        Chưa trả lời
                    </span>
                </div>

                <!-- Inner Question Box -->
                <div class="cyber-card bg-[#162035] border border-slate-700/60 rounded-2xl p-5 lg:p-7 shadow-inner flex-1 flex flex-col justify-between">
                    <div>
                        <!-- Question Prompt -->
                        <div id="q-prompt-container" class="text-base lg:text-lg text-slate-100 leading-relaxed space-y-3 select-text">
                            <!-- Question text and HTML tables rendered here -->
                        </div>

                        <!-- Question Options Preview inside Left Card (for Part I & Part II clarity) -->
                        <div id="q-left-options-preview" class="mt-6 space-y-2.5 text-slate-200">
                            <!-- Rendered dynamically -->
                        </div>
                    </div>

                    <!-- Detailed Solution Box (Shown after submission or when unlocked) -->
                    <div id="q-solution-box" class="hidden mt-6 pt-5 border-t border-emerald-700/50 bg-emerald-950/20 rounded-xl p-4">
                        <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm mb-2">
                            <i class="fa-solid fa-lightbulb"></i>
                            <span>LỜI GIẢI CHI TIẾT & ĐÁP ÁN ĐÚNG:</span>
                        </div>
                        <div id="q-solution-content" class="text-sm text-slate-200 leading-relaxed space-y-1 select-text"></div>
                    </div>
                </div>
            </section>

            <!-- RIGHT COLUMN: FULL-HEIGHT INTERACTION PANEL -->
            <section class="w-full lg:w-[440px] xl:w-[480px] flex flex-col shrink-0">
                
                <!-- PHẦN TƯƠNG TÁC CARD (FULL HEIGHT) -->
                <div class="cyber-panel bg-[#11192c] border border-slate-800/90 rounded-2xl p-6 flex flex-col shadow-2xl flex-1 overflow-y-auto">
                    <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-5 border-b border-slate-800">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-circle-check text-indigo-400 text-sm"></i>
                            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-300">PHẦN TƯƠNG TÁC TRẢ LỜI</h3>
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="answered-counter" class="text-[11px] font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-700/50 px-2.5 py-1 rounded-lg">Đã làm: 0/18</span>
                            <select id="quick-jump-select" onchange="jumpToQuestion(Number(this.value))" class="bg-[#162038] border border-slate-700 text-slate-200 text-[11px] font-semibold rounded-lg px-2.5 py-1 outline-none focus:border-indigo-500 cursor-pointer">
                                <!-- Options populated dynamically -->
                            </select>
                        </div>
                    </div>

                    <div class="mb-4 flex items-center justify-between">
                        <span id="interaction-hint" class="text-xs font-semibold text-indigo-300">Chọn 1 đáp án đúng</span>
                        <span id="current-q-index-label" class="text-xs text-slate-400 font-medium">Câu 1 / 18</span>
                    </div>

                    <!-- Dynamic Interactive Controls -->
                    <div id="interaction-workspace" class="flex-1 flex flex-col justify-center">
                        <!-- Injected via JS -->
                    </div>
                </div>

            </section>
        </div>
    </main>

    <!-- ==================== BOTTOM FOOTER BAR (MATCHING SCREENSHOT) ==================== -->
    <footer class="cyber-header bg-[#0a0f1d] border-t border-slate-800/90 px-6 py-3 flex items-center justify-between shrink-0 z-20">
        <div class="flex items-center space-x-3">
            <button id="btn-prev" onclick="navigateQuestion(-1)" class="px-4 py-2 rounded-xl bg-[#161f33] hover:bg-slate-800 text-slate-300 border border-slate-700/80 text-xs font-bold flex items-center gap-2 transition disabled:opacity-40 disabled:cursor-not-allowed">
                <i class="fa-solid fa-arrow-left text-[11px]"></i>
                <span>Trước</span>
            </button>
            <button id="btn-next" onclick="navigateQuestion(1)" class="px-5 py-2 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white text-xs font-bold flex items-center gap-2 shadow-lg shadow-indigo-600/30 transition disabled:opacity-40 disabled:cursor-not-allowed">
                <span>Tiếp theo</span>
                <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </button>
        </div>

        <!-- Right Progress Bar -->
        <div class="flex items-center gap-3">
            <span id="footer-progress-text" class="text-xs text-slate-400 hidden sm:inline">Tiến độ: 0%</span>
            <div class="w-28 sm:w-40 h-2 bg-slate-800 rounded-full overflow-hidden p-0.5">
                <div id="footer-progress-bar" class="h-full bg-gradient-to-r from-indigo-500 via-purple-500 to-teal-400 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
        </div>
    </footer>

    <!-- ==================== 1. STUDENT REGISTRATION MODAL (REQUIRED BEFORE EXAM) ==================== -->
    <div id="registration-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-[#131c31] border border-indigo-500/40 rounded-2xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-44 h-44 bg-indigo-600/20 rounded-full blur-2xl pointer-events-none"></div>
            
            <div class="flex items-center space-x-3 mb-5">
                <div class="logo-box w-12 h-12 rounded-xl flex flex-col items-center justify-center shrink-0">
                    <span class="text-sm font-extrabold text-pink-400 leading-none">TĐ</span>
                    <span class="text-[9px] font-bold text-indigo-200 tracking-widest mt-0.5">MATH</span>
                </div>
                <div>
                    <h2 class="text-lg md:text-xl font-extrabold text-white uppercase">LỚP TOÁN THẦY ĐÀI</h2>
                    <p class="text-xs text-slate-400">Đề ôn tập Kiểm tra Giữa kì I - Đề số 04 • Môn Toán 11</p>
                </div>
            </div>

            <!-- Exam Rules Summary Box -->
            <div class="bg-[#0d1424] border border-slate-800 rounded-xl p-4 mb-5 text-xs space-y-1.5 text-slate-300">
                <div class="font-bold text-amber-400 flex items-center gap-1.5 mb-1">
                    <i class="fa-solid fa-circle-info"></i> Cấu trúc đề thi & Cách tính điểm (Tổng: 10,0 điểm):
                </div>
                <p>• <strong>Phần I (6,0 điểm):</strong> 12 câu trắc nghiệm 4 lựa chọn (0,5 điểm / câu).</p>
                <p>• <strong>Phần II (2,0 điểm):</strong> 2 câu trắc nghiệm Đúng/Sai (Đúng 1 ý: 0,1đ; 2 ý: 0,25đ; 3 ý: 0,5đ; 4 ý: 1,0đ / câu).</p>
                <p>• <strong>Phần III (2,0 điểm):</strong> 4 câu trả lời ngắn (0,5 điểm / câu).</p>
                <p>• <strong>Thời gian làm bài:</strong> 45 phút (Đảo ngẫu nhiên câu hỏi, phương án A, B, C, D và các ý a, b, c, d).</p>
            </div>

            <!-- Form Inputs -->
            <form id="student-login-form" onsubmit="startExamSession(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                        Họ và tên học sinh <span class="text-rose-400">*</span>
                    </label>
                    <div class="relative">
                        <i class="fa-regular fa-user absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                        <input type="text" id="input-student-name" required placeholder="Nhập đầy đủ họ và tên (VD: Nguyễn Văn An)" 
                               class="w-full bg-[#0b1120] border border-slate-700 focus:border-indigo-500 rounded-xl pl-10 pr-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                        Lớp <span class="text-rose-400">*</span>
                    </label>
                    <div class="relative">
                        <i class="fa-solid fa-graduation-cap absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
                        <input type="text" id="input-student-class" required placeholder="Nhập lớp của bạn (VD: 11A1)" 
                               class="w-full bg-[#0b1120] border border-slate-700 focus:border-indigo-500 rounded-xl pl-10 pr-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition">
                    </div>
                </div>

                <div id="login-error-msg" class="hidden text-xs text-rose-400 font-medium"></div>

                <div class="pt-2 flex flex-col sm:flex-row gap-3">
                    <button type="submit" class="flex-1 py-3 px-5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-2 transition">
                        <i class="fa-solid fa-play"></i>
                        <span>Bắt Đầu Làm Bài (45 Phút)</span>
                    </button>
                    <button type="button" onclick="openTeacherDashboard()" class="py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-semibold text-xs flex items-center justify-center gap-2 transition">
                        <i class="fa-solid fa-chalkboard-user text-indigo-400"></i>
                        <span>Giáo viên xem DS</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== 2. SUBMIT CONFIRMATION MODAL ==================== -->
    <div id="submit-confirm-modal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-[#131c31] border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl text-center">
            <div class="w-14 h-14 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-paper-plane"></i>
            </div>
            <h3 class="text-xl font-extrabold text-white mb-2">Xác nhận nộp bài thi?</h3>
            <p id="submit-confirm-summary" class="text-sm text-slate-300 mb-6"></p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeSubmitConfirmModal()" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold border border-slate-700 transition">
                    Kiểm tra lại bài
                </button>
                <button onclick="finalizeExamSubmission()" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 text-xs font-extrabold shadow-lg shadow-amber-500/25 transition">
                    Nộp bài & Xem điểm ngay
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== 3. SCORE REPORT MODAL ==================== -->
    <div id="score-report-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden items-center justify-center p-4">
        <div class="bg-[#131c31] border border-indigo-500/50 rounded-2xl max-w-xl w-full p-6 md:p-8 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-extrabold text-white">KẾT QUẢ BÀI THI CỦA BẠN</h3>
                        <p id="result-student-info" class="text-xs text-slate-400"></p>
                    </div>
                </div>
                <div class="text-right">
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 block">Tổng điểm</span>
                    <span id="result-total-score" class="text-3xl font-black text-amber-400">0.00</span>
                    <span class="text-xs text-slate-400">/ 10đ</span>
                </div>
            </div>

            <!-- Detailed Part Breakdown -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
                <div class="bg-[#0b1120] border border-slate-800 rounded-xl p-3.5">
