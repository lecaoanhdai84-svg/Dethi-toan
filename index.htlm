                        <td>$4$</td>
                        <td>$1$</td>
                    </tr>
                </tbody>
            </table>
        `;

        // --- Complete 18 Questions Dataset from Word File ---
        const examQuestions = [
            // ================= PHẦN I: 12 CÂU (0.5 điểm/câu) =================
            {
                id: 1,
                displayNum: "Câu 1",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Đổi số đo của góc $450^\\circ$ sang radian ta được kết quả bằng",
                options: [
                    "$\\dfrac{5\\pi}{2}$",
                    "$\\dfrac{3\\pi}{2}$",
                    "$\\dfrac{5\\pi}{3}$",
                    "$\\dfrac{4\\pi}{3}$"
                ],
                correct: 0,
                baseExplanation: "Áp dụng công thức đổi độ sang radian: $\\alpha = 450^\\circ \\cdot \\dfrac{\\pi}{180^\\circ} = \\dfrac{5\\pi}{2}$.",
                solution: ""
            },
            {
                id: 2,
                displayNum: "Câu 2",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Một bánh xe có $72$ răng. Số đo góc mà bánh xe đã quay được khi di chuyển $15$ răng là",
                options: [
                    "$60^\\circ$",
                    "$75^\\circ$",
                    "$45^\\circ$",
                    "$90^\\circ$"
                ],
                correct: 1,
                baseExplanation: "Một vòng quay toàn phần ($360^\\circ$) ứng với $72$ răng. Khi di chuyển $15$ răng, số đo góc quay được là $\\dfrac{15}{72} \\times 360^\\circ = 75^\\circ$.",
                solution: ""
            },
            {
                id: 3,
                displayNum: "Câu 3",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Cho $\\alpha, \\beta$ là các góc lượng giác. Khẳng định nào sau đây đúng?",
                options: [
                    "$\\cos(\\alpha - \\beta) = \\cos\\alpha\\cos\\beta - \\sin\\alpha\\sin\\beta$",
                    "$\\cos(\\alpha - \\beta) = \\cos\\alpha\\cos\\beta + \\sin\\alpha\\sin\\beta$",
                    "$\\cos(\\alpha - \\beta) = \\sin\\alpha\\cos\\beta + \\cos\\alpha\\sin\\beta$",
                    "$\\cos(\\alpha - \\beta) = \\sin\\alpha\\sin\\beta - \\cos\\alpha\\cos\\beta$"
                ],
                correct: 1,
                baseExplanation: "Theo công thức cộng lượng giác: $\\cos(\\alpha - \\beta) = \\cos\\alpha\\cos\\beta + \\sin\\alpha\\sin\\beta$.",
                solution: ""
            },
            {
                id: 4,
                displayNum: "Câu 4",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Tập xác định của hàm số $y = \\cot x$ là",
                options: [
                    "$D = \\mathbb{R} \\setminus \\{k\\pi, k \\in \\mathbb{Z}\\}$",
                    "$D = \\mathbb{R} \\setminus \\left\\{\\dfrac{\\pi}{2} + k\\pi, k \\in \\mathbb{Z}\\right\\}$",
                    "$D = \\mathbb{R} \\setminus \\{k2\\pi, k \\in \\mathbb{Z}\\}$",
                    "$D = \\mathbb{R} \\setminus \\left\\{\\dfrac{\\pi}{2} + k2\\pi, k \\in \\mathbb{Z}\\right\\}$"
                ],
                correct: 0,
                baseExplanation: "Hàm số $y = \\cot x = \\dfrac{\\cos x}{\\sin x}$ xác định khi $\\sin x \\neq 0 \\Leftrightarrow x \\neq k\\pi \\; (k \\in \\mathbb{Z})$.",
                solution: ""
            },
            {
                id: 5,
                displayNum: "Câu 5",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Nghiệm của phương trình $\\cos x = 1$ là",
                options: [
                    "$x = k2\\pi, \\; k \\in \\mathbb{Z}$",
                    "$x = \\dfrac{\\pi}{2} + k\\pi, \\; k \\in \\mathbb{Z}$",
                    "$x = k\\pi, \\; k \\in \\mathbb{Z}$",
                    "$x = \\pi + k2\\pi, \\; k \\in \\mathbb{Z}$"
                ],
                correct: 0,
                baseExplanation: "Phương trình lượng giác đặc biệt: $\\cos x = 1 \\Leftrightarrow x = k2\\pi \\; (k \\in \\mathbb{Z})$.",
                solution: ""
            },
            {
                id: 6,
                displayNum: "Câu 6",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Cho dãy số $(u_n)$ có số hạng tổng quát $u_n = \\dfrac{2n-1}{n+1}$. Ba số hạng đầu tiên của dãy số là",
                options: [
                    "$\\dfrac{1}{2}; \\; 1; \\; \\dfrac{5}{4}$",
                    "$1; \\; 2; \\; 3$",
                    "$\\dfrac{1}{2}; \\; \\dfrac{3}{4}; \\; 1$",
                    "$\\dfrac{1}{2}; \\; 1; \\; \\dfrac{3}{2}$"
                ],
                correct: 0,
                baseExplanation: "Thay lần lượt $n = 1, 2, 3$: $u_1 = \\dfrac{2(1)-1}{1+1} = \\dfrac{1}{2}$; $u_2 = \\dfrac{2(2)-1}{2+1} = 1$; $u_3 = \\dfrac{2(3)-1}{3+1} = \\dfrac{5}{4}$.",
                solution: ""
            },
            {
                id: 7,
                displayNum: "Câu 7",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Cho cấp số cộng $(u_n)$ có số hạng đầu $u_1 = -5$ và công sai $d = 3$. Tìm số hạng thứ $15$ của cấp số cộng đã cho.",
                options: [
                    "$u_{15} = 37$",
                    "$u_{15} = 40$",
                    "$u_{15} = 34$",
                    "$u_{15} = 42$"
                ],
                correct: 0,
                baseExplanation: "Sử dụng công thức số hạng tổng quát cấp số cộng: $u_{15} = u_1 + 14d = -5 + 14 \\cdot 3 = 37$.",
                solution: ""
            },
            {
                id: 8,
                displayNum: "Câu 8",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Trong các dãy số sau, dãy nào là một cấp số nhân?",
                options: [
                    "$2; \\; 4; \\; 8; \\; 16$",
                    "$1; \\; 2; \\; 3; \\; 4$",
                    "$1; \\; -2; \\; -4; \\; -8$",
                    "$-1; \\; -3; \\; -5; \\; -7$"
                ],
                correct: 0,
                baseExplanation: "Dãy số $2; 4; 8; 16$ có tỉ số $\\dfrac{u_{n+1}}{u_n} = 2$ không đổi nên là cấp số nhân với công bội $q = 2$.",
                solution: ""
            },
            {
                id: 9,
                displayNum: "Câu 9",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: "Cho cấp số nhân $(u_n)$ có số hạng đầu $u_1 = 3$ và công bội $q = -2$. Tìm số hạng thứ $5$.",
                options: [
                    "$u_5 = -48$",
                    "$u_5 = 48$",
                    "$u_5 = -96$",
                    "$u_5 = 96$"
                ],
                correct: 1,
                baseExplanation: "Ta có công thức cấp số nhân: $u_5 = u_1 \\cdot q^4 = 3 \\cdot (-2)^4 = 3 \\cdot 16 = 48$.",
                solution: ""
            },
            {
                id: 10,
                displayNum: "Câu 10",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: `Điều tra về thời gian hoàn thành một sản phẩm (đơn vị: phút) của $40$ công nhân, ta có kết quả:${TABLE_Q10}Số công nhân hoàn thành sản phẩm với thời gian từ $14$ đến dưới $16$ phút là`,
                options: [
                    "$14$",
                    "$10$",
                    "$7$",
                    "$16$"
                ],
                correct: 0,
                baseExplanation: "Dựa vào bảng tần số ghép nhóm, ở nhóm $[14; 16)$ có số công nhân tương ứng là $14$.",
                solution: ""
            },
            {
                id: 11,
                displayNum: "Câu 11",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: `Khảo sát thời gian xem ti vi trong một ngày của một số học sinh khối 11 thu được mẫu số liệu ghép nhóm sau:${TABLE_Q11_12}Giá trị đại diện của nhóm $[20; 40)$ là`,
                options: [
                    "$30$",
                    "$40$",
                    "$20$",
                    "$10$"
                ],
                correct: 0,
                baseExplanation: "Giá trị đại diện của nhóm $[20; 40)$ là trung bình cộng hai đầu mút: $c_i = \\dfrac{20 + 40}{2} = 30$.",
                solution: ""
            },
            {
                id: 12,
                displayNum: "Câu 12",
                part: 1,
                partName: "PHẦN I • Trắc nghiệm 4 lựa chọn (0,5 điểm)",
                type: "mcq",
                prompt: `Khảo sát thời gian xem ti vi trong một ngày của một số học sinh khối 11 thu được mẫu số liệu ghép nhóm sau:${TABLE_Q11_12}Nhóm chứa mốt của mẫu số liệu ghép nhóm này là`,
                options: [
                    "$[40; 60)$",
                    "$[20; 40)$",
                    "$[60; 80)$",
                    "$[80; 100)$"
                ],
                correct: 0,
                baseExplanation: "Nhóm có tần số lớn nhất là nhóm $[40; 60)$ (với $12$ học sinh), do đó nhóm chứa mốt là $[40; 60)$.",
                solution: ""
            },

            // ================= PHẦN II: 2 CÂU ĐÚNG/SAI (1.0 điểm/câu) =================
            {
                id: 13,
                displayNum: "Câu 1 (Phần II)",
                part: 2,
                partName: "PHẦN II • Trắc nghiệm Đúng/Sai (Tối đa 1,0 điểm)",
                type: "tf",
                prompt: "Cho phương trình lượng giác $\\sin\\left(x - \\dfrac{\\pi}{3}\\right) = \\dfrac{1}{2}$. Xét tính đúng sai của các mệnh đề sau:",
                rawItems: [
                    {
                        text: "Phương trình đã cho tương đương với $\\sin\\left(x - \\dfrac{\\pi}{3}\\right) = \\sin\\dfrac{\\pi}{6}$.",
                        isTrue: true,
                        explain: "<strong>Đúng:</strong> Vì $\\sin\\dfrac{\\pi}{6} = \\dfrac{1}{2}$."
                    },
                    {
                        text: "Phương trình có các họ nghiệm là $x = \\dfrac{\\pi}{2} + k2\\pi$ và $x = \\dfrac{7\\pi}{6} + k2\\pi \\; (k \\in \\mathbb{Z})$.",
                        isTrue: true,
                        explain: "<strong>Đúng:</strong> Giải phương trình: $x - \\dfrac{\\pi}{3} = \\dfrac{\\pi}{6} + k2\\pi \\Rightarrow x = \\dfrac{\\pi}{2} + k2\\pi$ hoặc $x - \\dfrac{\\pi}{3} = \\pi - \\dfrac{\\pi}{6} + k2\\pi \\Rightarrow x = \\dfrac{7\\pi}{6} + k2\\pi$."
                    },
                    {
                        text: "Trên khoảng $(0; \\pi)$, phương trình có đúng $2$ nghiệm.",
                        isTrue: false,
                        explain: "<strong>Sai:</strong> Trên khoảng $(0; \\pi)$, phương trình chỉ có duy nhất $1$ nghiệm là $x = \\dfrac{\\pi}{2}$ (vì $\\dfrac{7\\pi}{6} > \\pi$)."
                    },
                    {
                        text: "Tổng tất cả các nghiệm của phương trình thuộc đoạn $[0; 2\\pi]$ bằng $\\dfrac{5\\pi}{3}$.",
                        isTrue: true,
                        explain: "<strong>Đúng:</strong> Trên đoạn $[0; 2\\pi]$, các nghiệm là $x_1 = \\dfrac{\\pi}{2}$ và $x_2 = \\dfrac{7\\pi}{6}$. Tổng hai nghiệm là $\\dfrac{\\pi}{2} + \\dfrac{7\\pi}{6} = \\dfrac{5\\pi}{3}$."
                    }
                ],
                statements: [],
                correct: [],
                solution: ""
            },
            {
                id: 14,
                displayNum: "Câu 2 (Phần II)",
                part: 2,
                partName: "PHẦN II • Trắc nghiệm Đúng/Sai (Tối đa 1,0 điểm)",
                type: "tf",
                prompt: `Khảo sát cân nặng của $25$ quả cam ở lô hàng A được cho ở bảng sau:${TABLE_PART2_Q2}Xét tính đúng sai của các mệnh đề sau:`,
                rawItems: [
                    {
                        text: "Giá trị đại diện của nhóm $[160; 165)$ bằng $162,5$.",
                        isTrue: true,
                        explain: "<strong>Đúng:</strong> Giá trị đại diện của nhóm $[160; 165)$ là $\\dfrac{160 + 165}{2} = 162,5$."
                    },
                    {
                        text: "Cân nặng trung bình của mỗi quả cam ở lô A là $161,7$ (gam).",
                        isTrue: true,
                        explain: "<strong>Đúng:</strong> $\\bar{x} = \\dfrac{2\\cdot 152,5 + 6\\cdot 157,5 + 12\\cdot 162,5 + 4\\cdot 167,5 + 1\\cdot 172,5}{25} = \\dfrac{4042,5}{25} = 161,7$ (gam)."
                    },
                    {
                        text: "Nhóm chứa trung vị là nhóm $[155; 160)$.",
                        isTrue: false,
                        explain: "<strong>Sai:</strong> Cỡ mẫu $n = 25$, trung vị là giá trị ở vị trí thứ $13$ thuộc nhóm $[160; 165)$ (do $2 + 6 = 8 < 13 \\le 20$)."
                    },
                    {
                        text: "Tứ phân vị thứ nhất $Q_1$ của mẫu số liệu là $158,125$.",
                        isTrue: false,
                        explain: "<strong>Sai:</strong> Nhóm chứa $Q_1$ là $[155; 160)$. Ta có $Q_1 = 155 + \\dfrac{\\frac{25}{4} - 2}{6}\\cdot 5 \\approx 158,54 \\neq 158,125$."
                    }
                ],
                statements: [],
                correct: [],
                solution: ""
            },

            // ================= PHẦN III: 4 CÂU TRẢ LỜI NGẮN (0.5 điểm/câu) =================
            {
                id: 15,
                displayNum: "Câu 1 (Phần III)",
                part: 3,
                partName: "PHẦN III • Trắc nghiệm trả lời ngắn (0,5 điểm)",
                type: "short",
                prompt: "Cho góc lượng giác $a$ thỏa mãn $\\sin a = \\dfrac{3}{5}$ và $\\dfrac{\\pi}{2} < a < \\pi$. Tính giá trị của biểu thức $P = -\\tan a$ (viết kết quả dưới dạng số thập phân).",
                acceptedAnswers: ["0.75", "0,75"],
                displayAnswer: "0,75",
                solution: "Vì $\\dfrac{\\pi}{2} < a < \\pi$ nên $\\cos a < 0 \\Rightarrow \\cos a = -\\sqrt{1 - \\sin^2 a} = -\\dfrac{4}{5}$. Suy ra $\\tan a = \\dfrac{\\sin a}{\\cos a} = -\\dfrac{3}{4} = -0,75$. Vậy $P = -\\tan a = 0,75$."
            },
            {
                id: 16,
                displayNum: "Câu 2 (Phần III)",
                part: 3,
                partName: "PHẦN III • Trắc nghiệm trả lời ngắn (0,5 điểm)",
                type: "short",
                prompt: "Tìm giá trị lớn nhất của hàm số $y = 3\\cos 2x + 1$ trên $\\mathbb{R}$.",
                acceptedAnswers: ["4"],
                displayAnswer: "4",
                solution: "Vì $-1 \\le \\cos 2x \\le 1 \\; \\forall x \\in \\mathbb{R}$ nên $-2 \\le 3\\cos 2x + 1 \\le 4$. Vậy giá trị lớn nhất của hàm số bằng $4$."
            },
            {
                id: 17,
                displayNum: "Câu 3 (Phần III)",
                part: 3,
                partName: "PHẦN III • Trắc nghiệm trả lời ngắn (0,5 điểm)",
                type: "short",
                prompt: "Cho cấp số cộng $(u_n)$ có số hạng thứ ba $u_3 = 10$ và số hạng thứ bảy $u_7 = 22$. Tìm số hạng đầu tiên $u_1$ của cấp số cộng đó.",
                acceptedAnswers: ["4"],
                displayAnswer: "4",
                solution: "Ta có hệ phương trình: $\\begin{cases} u_1 + 2d = 10 \\\\ u_1 + 6d = 22 \\end{cases} \\Leftrightarrow \\begin{cases} 4d = 12 \\\\ u_1 = 10 - 2d \\end{cases} \\Leftrightarrow \\begin{cases} d = 3 \\\\ u_1 = 4 \\end{cases}$. Vậy $u_1 = 4$."
            },
            {
                id: 18,
                displayNum: "Câu 4 (Phần III)",
                part: 3,
                partName: "PHẦN III • Trắc nghiệm trả lời ngắn (0,5 điểm)",
                type: "short",
                prompt: "Người ta xếp các viên gạch thành dạng hình tháp theo quy luật: hàng dưới cùng có $30$ viên, hàng thứ hai từ dưới lên có $29$ viên, hàng thứ ba có $28$ viên, và cứ tiếp tục giảm dần mỗi hàng $1$ viên. Nếu có tổng cộng $15$ hàng thì có tất cả bao nhiêu viên gạch đã được xếp?",
                acceptedAnswers: ["345"],
                displayAnswer: "345",
                solution: "Số viên gạch ở mỗi hàng lập thành một cấp số cộng với $u_1 = 30$, công sai $d = -1$ và $n = 15$ hàng. Tổng số viên gạch là $S_{15} = \\dfrac{15\\cdot [2\\cdot 30 + (15 - 1)\\cdot (-1)]}{2} = \\dfrac{15 \\cdot 46}{2} = 345$ viên."
            }
        ];

        // --- Application State ---
        let currentIdx = 0;
        let studentInfo = { name: "", className: "" };
        let userAnswers = {};
        let examStarted = false;
        let examSubmitted = false;
        let solutionsUnlocked = false;
        let remainingSeconds = 45 * 60; // 45 minutes
        let timerInterval = null;
        let allSubmissions = [];

        // Initialize empty answers structure
        function resetUserAnswers() {
            examQuestions.forEach(q => {
                if (q.type === 'mcq') userAnswers[q.id] = null;
                if (q.type === 'tf') userAnswers[q.id] = [null, null, null, null];
                if (q.type === 'short') userAnswers[q.id] = "";
            });
        }
        resetUserAnswers();

        // Fisher-Yates shuffle helper
        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        // Shuffle questions independently within Part I, Part II, and Part III
        // AND shuffle options A, B, C, D in Part I + statements a), b), c), d) in Part II
        function shuffleQuestionsByPart() {
            const mcqLetters = ['A', 'B', 'C', 'D'];
            const tfPrefixes = ['a)', 'b)', 'c)', 'd)'];

            // 1. Shuffle Part I questions and their 4 options (A, B, C, D)
            const part1 = shuffleArray(examQuestions.filter(q => q.part === 1));
            part1.forEach((q, idx) => {
                q.displayNum = `Câu ${idx + 1}`;
                const optionPairs = q.options.map((optText, optIdx) => ({
                    text: optText,
                    isCorrect: optIdx === q.correct
                }));
                const shuffledPairs = shuffleArray(optionPairs);
                q.options = shuffledPairs.map(item => item.text);
                q.correct = shuffledPairs.findIndex(item => item.isCorrect);
                const correctLetter = mcqLetters[q.correct];
                q.solution = `${q.baseExplanation} Chọn đáp án <strong>${correctLetter}</strong>.`;
            });

            // 2. Shuffle Part II questions and their 4 statements a), b), c), d)
            const part2 = shuffleArray(examQuestions.filter(q => q.part === 2));
            part2.forEach((q, idx) => {
                q.displayNum = `Câu ${idx + 1} (Phần II)`;
                const shuffledItems = shuffleArray(q.rawItems);
                q.statements = shuffledItems.map((item, sIdx) => `${tfPrefixes[sIdx]} ${item.text}`);
                q.correct = shuffledItems.map(item => item.isTrue);
                q.solution = shuffledItems
                    .map((item, sIdx) => `• <strong>${tfPrefixes[sIdx]}</strong> ${item.explain}`)
                    .join('<br>');
            });

            // 3. Shuffle Part III questions
            const part3 = shuffleArray(examQuestions.filter(q => q.part === 3));
            part3.forEach((q, idx) => {
                q.displayNum = `Câu ${idx + 1} (Phần III)`;
            });

            examQuestions.length = 0;
            examQuestions.push(...part1, ...part2, ...part3);
        }

        // --- Firebase Setup (Rule 1, 2, 3 Compliant) ---
        let db = null;
        let auth = null;
        let currentUser = null;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'math11-exam-ktgki04';

        async function initFirebase() {
            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    const firebaseConfig = JSON.parse(__firebase_config);
                    const app = initializeApp(firebaseConfig);
                    auth = getAuth(app);
                    db = getFirestore(app);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    onAuthStateChanged(auth, (user) => {
                        currentUser = user;
                        if (user) {
                            listenToSubmissions();
                        }
                    });
                }
            } catch (err) {
                console.warn("Chế độ lưu trữ cục bộ tạm thời:", err);
            }
        }

        function listenToSubmissions() {
            if (!db || !currentUser) return;
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'exam_submissions');
            onSnapshot(colRef, (snapshot) => {
                const list = [];
                snapshot.forEach(docSnap => {
                    list.push({ id: docSnap.id, ...docSnap.data() });
                });
                // Sort in JS memory (newest first)
                list.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
                allSubmissions = list;
                document.getElementById('submission-count-badge').textContent = allSubmissions.length;
                renderTeacherTable();
            }, (error) => {
                console.error("Lỗi đồng bộ danh sách bài nộp:", error);
            });
        }

        async function saveSubmissionToCloud(record) {
            // Also push to in-memory list immediately for instant UI feedback
            allSubmissions.unshift(record);
            document.getElementById('submission-count-badge').textContent = allSubmissions.length;
            renderTeacherTable();

            if (!db || !currentUser) return;
            try {
                const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'exam_submissions');
                await addDoc(colRef, record);
            } catch (e) {
                console.error("Không thể lưu lên đám mây:", e);
            }
        }

        // --- Math Rendering Helper ---
        function triggerMathRender() {
            if (window.renderMathInElement) {
                window.renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\(', right: '\\)', display: false},
                        {left: '\\[', right: '\\]', display: true}
                    ],
                    throwOnError: false
                });
            }
        }

        // --- Check if Question is Answered ---
        function isQuestionAnswered(q) {
            const ans = userAnswers[q.id];
            if (q.type === 'mcq') return ans !== null && ans !== undefined;
            if (q.type === 'tf') return Array.isArray(ans) && ans.some(v => v !== null);
            if (q.type === 'short') return typeof ans === 'string' && ans.trim() !== '';
            return false;
        }

        function countTotalAnswered() {
            return examQuestions.filter(q => isQuestionAnswered(q)).length;
        }

        // --- Render Quick Jump Select & Progress ---
        function buildPalette() {
            const selectEl = document.getElementById('quick-jump-select');
            if (!selectEl) return;
            selectEl.innerHTML = '';

            examQuestions.forEach((q, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                const statusSym = isQuestionAnswered(q) ? '✓ ' : '';
                opt.textContent = `${statusSym}${q.displayNum}`;
                selectEl.appendChild(opt);
            });
            selectEl.value = currentIdx;
        }

        function updatePaletteAndProgress() {
            buildPalette();

            const doneCount = countTotalAnswered();
            const pct = Math.round((doneCount / examQuestions.length) * 100);
            document.getElementById('answered-counter').textContent = `Đã làm: ${doneCount}/${examQuestions.length}`;
            document.getElementById('footer-progress-text').textContent = `Tiến độ: ${pct}%`;
            document.getElementById('footer-progress-bar').style.width = `${pct}%`;

            const indexLabel = document.getElementById('current-q-index-label');
            if (indexLabel) {
                indexLabel.textContent = `Câu ${currentIdx + 1} / ${examQuestions.length}`;
            }
        }

        // --- Render Current Question ---
        function renderQuestion(idx) {
            currentIdx = idx;
            const q = examQuestions[idx];
            const ans = userAnswers[q.id];

            // Header Info
            document.getElementById('q-number-title').textContent = q.displayNum;
            document.getElementById('q-part-badge').textContent = q.partName;

            const answered = isQuestionAnswered(q);
            const statusBadge = document.getElementById('q-status-badge');
            if (answered) {
                statusBadge.innerHTML = `<span class="text-emerald-400 font-semibold"><i class="fa-solid fa-check-circle mr-1"></i>Đã trả lời</span>`;
            } else {
                statusBadge.innerHTML = `<span class="text-slate-400"><i class="fa-regular fa-circle mr-1"></i>Chưa trả lời</span>`;
            }

            // Prompt Content
            document.getElementById('q-prompt-container').innerHTML = `<div class="font-medium">${q.prompt}</div>`;

            // Left Options Preview & Right Interaction Area
            const leftPreview = document.getElementById('q-left-options-preview');
            const rightWorkspace = document.getElementById('interaction-workspace');
            const hintEl = document.getElementById('interaction-hint');
            leftPreview.innerHTML = '';
            rightWorkspace.innerHTML = '';

            const labels = ['A', 'B', 'C', 'D'];

            if (q.type === 'mcq') {
                hintEl.textContent = "Chọn 1 phương án đúng (0,5 điểm)";

                // Left side shows the 4 mathematical choices clearly
                let leftHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">`;
                q.options.forEach((optText, optIdx) => {
                    const isSelected = ans === optIdx;
                    leftHtml += `
                        <div onclick="handleSelectMCQ(${q.id}, ${optIdx})" 
                             class="cursor-pointer p-3.5 rounded-xl border transition flex items-center gap-3 ${isSelected ? 'border-indigo-500 bg-indigo-950/40' : 'border-slate-700/70 bg-[#11192c]/70 hover:border-slate-500'}">
                            <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-extrabold shrink-0 ${isSelected ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-indigo-300 border border-slate-600'}">
                                ${labels[optIdx]}
                            </span>
                            <span class="text-base">${optText}</span>
                        </div>
                    `;
                });
                leftHtml += `</div>`;
                leftPreview.innerHTML = leftHtml;

                // Right side interactive cards (spacious full-height layout)
                let rightHtml = `<div class="space-y-3.5 my-auto">`;
                q.options.forEach((optText, optIdx) => {
                    const isSelected = ans === optIdx;
                    let reviewClass = '';
                    if (examSubmitted || solutionsUnlocked) {
                        if (optIdx === q.correct) reviewClass = 'correct-review';
                        else if (isSelected && optIdx !== q.correct) reviewClass = 'wrong-review';
                    }

                    rightHtml += `
                        <div onclick="handleSelectMCQ(${q.id}, ${optIdx})" 
                             class="mcq-item ${isSelected ? 'selected' : ''} ${reviewClass} cursor-pointer p-4 rounded-xl border border-slate-700/80 bg-[#162038] hover:border-indigo-400 transition flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="mcq-badge w-10 h-10 rounded-xl border border-slate-600 bg-slate-800 flex items-center justify-center font-extrabold text-sm text-slate-200">
                                    ${labels[optIdx]}
                                </div>
                                <div class="text-base font-medium text-slate-100">${optText}</div>
                            </div>
                            ${isSelected ? '<i class="fa-solid fa-circle-check text-indigo-400 text-lg"></i>' : ''}
                        </div>
                    `;
                });
                rightHtml += `</div>`;
                rightWorkspace.innerHTML = rightHtml;
            } 
            else if (q.type === 'tf') {
                hintEl.textContent = "Chọn Đúng hoặc Sai cho mỗi ý a, b, c, d";

                // Left side shows statements a, b, c, d
                let leftHtml = `<div class="space-y-3 pt-2">`;
                q.statements.forEach((stmt, sIdx) => {
                    const chosen = ans[sIdx];
                    const badgeText = chosen === true ? 'Đã chọn: ĐÚNG' : (chosen === false ? 'Đã chọn: SAI' : 'Chưa chọn');
                    const badgeColor = chosen === true ? 'text-emerald-400 border-emerald-700/60 bg-emerald-950/40' : (chosen === false ? 'text-rose-400 border-rose-700/60 bg-rose-950/40' : 'text-slate-400 border-slate-700 bg-slate-800/50');
                    leftHtml += `
                        <div class="p-3.5 rounded-xl border border-slate-700/70 bg-[#11192c]/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <div class="text-sm md:text-base leading-relaxed">${stmt}</div>
                            <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg border shrink-0 self-start sm:self-center ${badgeColor}">
                                ${badgeText}
                            </span>
                        </div>
                    `;
                });
                leftHtml += `</div>`;
                leftPreview.innerHTML = leftHtml;

                // Right side shows interactive Đúng / Sai toggle buttons
                let rightHtml = `
                    <div class="my-auto space-y-4">
                        <div class="bg-[#0d1424] border border-slate-800 rounded-xl p-3.5 text-xs text-slate-400 leading-relaxed">
                            <strong class="text-indigo-300">Quy tắc tính điểm:</strong> Đúng 1 ý: <span class="text-white">0,1đ</span> • 2 ý: <span class="text-white">0,25đ</span> • 3 ý: <span class="text-white">0,5đ</span> • Cả 4 ý: <span class="text-amber-400 font-bold">1,0đ</span>
                        </div>
                        <div class="space-y-3.5">
                `;
                const subLabels = ['Mệnh đề a)', 'Mệnh đề b)', 'Mệnh đề c)', 'Mệnh đề d)'];
                q.statements.forEach((_, sIdx) => {
                    const chosen = ans[sIdx];
                    const btnTrueClass = chosen === true 
                        ? 'bg-emerald-600 text-white border-emerald-400 shadow-lg shadow-emerald-600/30' 
                        : 'bg-slate-800 text-slate-300 border-slate-700 hover:border-emerald-500/60';
                    const btnFalseClass = chosen === false 
                        ? 'bg-rose-600 text-white border-rose-400 shadow-lg shadow-rose-600/30' 
                        : 'bg-slate-800 text-slate-300 border-slate-700 hover:border-rose-500/60';

                    rightHtml += `
                        <div class="p-4 rounded-xl border border-slate-700/80 bg-[#162038] flex items-center justify-between">
                            <span class="text-sm font-extrabold text-indigo-300">${subLabels[sIdx]}</span>
                            <div class="flex items-center gap-2.5">
                                <button type="button" onclick="handleSelectTF(${q.id}, ${sIdx}, true)" 
                                        class="px-5 py-2 rounded-xl border text-xs font-bold transition ${btnTrueClass}">
                                    <i class="fa-solid fa-check mr-1.5"></i>Đúng
                                </button>
                                <button type="button" onclick="handleSelectTF(${q.id}, ${sIdx}, false)" 
                                        class="px-5 py-2 rounded-xl border text-xs font-bold transition ${btnFalseClass}">
                                    <i class="fa-solid fa-xmark mr-1.5"></i>Sai
                                </button>
                            </div>
                        </div>
                    `;
                });
                rightHtml += `</div></div>`;
                rightWorkspace.innerHTML = rightHtml;
            }
            else if (q.type === 'short') {
                hintEl.textContent = "Điền đáp số (0,5 điểm)";

                rightWorkspace.innerHTML = `
                    <div class="bg-[#162038] border border-slate-700/80 rounded-2xl p-5 space-y-4">
                        <div class="flex items-center gap-2 text-indigo-300 text-xs font-bold">
                            <i class="fa-solid fa-keyboard"></i>
                            <span>NHẬP ĐÁP ÁN TRẢ LỜI NGẮN</span>
                        </div>
                        <input type="text" id="short-answer-input" value="${ans || ''}" 
                               ${examSubmitted ? 'disabled' : ''}
                               oninput="handleInputShort(${q.id}, this.value)"
                               placeholder="Nhập số (VD: 0,75 hoặc 345)..."
                               class="w-full bg-[#0b1120] border-2 border-indigo-500/60 focus:border-indigo-400 rounded-xl px-4 py-3.5 text-lg font-extrabold text-amber-300 placeholder-slate-600 outline-none transition tracking-wider text-center">
                        <p class="text-[11px] text-slate-400 leading-relaxed">
                            * Lưu ý: Với số thập phân, bạn có thể dùng dấu phẩy <code class="text-indigo-300">(,)</code> hoặc dấu chấm <code class="text-indigo-300">(.)</code> đều được chấp nhận (ví dụ: <strong>0,75</strong> hoặc <strong>0.75</strong>).
                        </p>
                    </div>
                `;
            }

            // Solution Visibility
            const solBox = document.getElementById('q-solution-box');
            const solContent = document.getElementById('q-solution-content');
            if (solutionsUnlocked || examSubmitted) {
                solBox.classList.remove('hidden');
                solContent.innerHTML = q.solution;
            } else {
                solBox.classList.add('hidden');
            }

            // Prev / Next button state
            document.getElementById('btn-prev').disabled = (idx === 0);
            document.getElementById('btn-next').disabled = (idx === examQuestions.length - 1);

            updatePaletteAndProgress();
            setTimeout(triggerMathRender, 10);
        }

        // --- Interaction Handlers ---
        window.handleSelectMCQ = function(qId, optIdx) {
            if (examSubmitted) {
                showToast("Bài thi đã nộp, không thể thay đổi đáp án!");
                return;
            }
            userAnswers[qId] = optIdx;
            renderQuestion(currentIdx);
        };

        window.handleSelectTF = function(qId, stmtIdx, boolVal) {
            if (examSubmitted) {
                showToast("Bài thi đã nộp, không thể thay đổi đáp án!");
                return;
            }
            userAnswers[qId][stmtIdx] = boolVal;
            renderQuestion(currentIdx);
        };

        window.handleInputShort = function(qId, val) {
            if (examSubmitted) return;
            userAnswers[qId] = val;
            updatePaletteAndProgress();
            const statusBadge = document.getElementById('q-status-badge');
            if (val.trim() !== '') {
                statusBadge.innerHTML = `<span class="text-emerald-400 font-semibold"><i class="fa-solid fa-check-circle mr-1"></i>Đã trả lời</span>`;
            } else {
                statusBadge.innerHTML = `<span class="text-slate-400"><i class="fa-regular fa-circle mr-1"></i>Chưa trả lời</span>`;
            }
        };

        window.navigateQuestion = function(delta) {
            const next = currentIdx + delta;
            if (next >= 0 && next < examQuestions.length) {
                renderQuestion(next);
            }
        };

        window.jumpToQuestion = function(idx) {
            renderQuestion(idx);
        };

        // --- Student Registration & Timer ---
        window.startExamSession = function(e) {
            e.preventDefault();
            const nameInput = document.getElementById('input-student-name').value.trim();
            const classInput = document.getElementById('input-student-class').value.trim();

            if (!nameInput || !classInput) {
                const err = document.getElementById('login-error-msg');
                err.textContent = "Vui lòng nhập đầy đủ Họ tên và Lớp của bạn!";
                err.classList.remove('hidden');
                return;
            }

            studentInfo.name = nameInput;
            studentInfo.className = classInput.toUpperCase();

            document.getElementById('header-student-name').textContent = studentInfo.name;
            document.getElementById('header-student-class').textContent = studentInfo.className;
            document.getElementById('registration-modal').classList.add('hidden');

            // Shuffle questions within each part and reset answers for the new session
            shuffleQuestionsByPart();
            resetUserAnswers();

            examStarted = true;
            startCountdown();
            renderQuestion(0);
            showToast(`Đã đảo đề! Chúc ${studentInfo.name} (${studentInfo.className}) làm bài tốt!`);
        };

        function startCountdown() {
            const display = document.getElementById('timer-display');
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                if (examSubmitted) {
                    clearInterval(timerInterval);
                    return;
                }
                remainingSeconds--;
                if (remainingSeconds <= 0) {
                    remainingSeconds = 0;
                    clearInterval(timerInterval);
                    display.textContent = "00:00";
                    showToast("Đã hết thời gian làm bài! Hệ thống tự động nộp bài.");
                    finalizeExamSubmission();
                    return;
                }
                const mins = Math.floor(remainingSeconds / 60);
                const secs = remainingSeconds % 60;
                display.textContent = `${mins < 10 ? '0' + mins : mins}:${secs < 10 ? '0' + secs : secs}`;
            }, 1000);
        }

        // --- Scoring Calculation Engine ---
        function calculateExamGrades() {
            let part1Score = 0;
            let part1CorrectCount = 0;

            let part2Score = 0;
            let part2Details = [];

            let part3Score = 0;
            let part3CorrectCount = 0;

            examQuestions.forEach(q => {
                const ans = userAnswers[q.id];

                if (q.part === 1) {
                    if (ans === q.correct) {
                        part1Score += 0.5;
                        part1CorrectCount++;
                    }
                } 
                else if (q.part === 2) {
                    let matchedCount = 0;
                    for (let i = 0; i < 4; i++) {
                        if (ans[i] !== null && ans[i] === q.correct[i]) {
                            matchedCount++;
                        }
                    }
                    let qScore = 0;
                    if (matchedCount === 1) qScore = 0.1;
                    else if (matchedCount === 2) qScore = 0.25;
                    else if (matchedCount === 3) qScore = 0.5;
                    else if (matchedCount === 4) qScore = 1.0;

                    part2Score += qScore;
                    part2Details.push(`${q.displayNum}: đúng ${matchedCount}/4 ý (+${qScore}đ)`);
                } 
                else if (q.part === 3) {
                    const cleaned = String(ans || '').trim().replace(/\s+/g, '');
                    if (q.acceptedAnswers.includes(cleaned)) {
                        part3Score += 0.5;
                        part3CorrectCount++;
                    }
                }
            });

            const totalScore = Number((part1Score + part2Score + part3Score).toFixed(2));
            return {
                part1Score: Number(part1Score.toFixed(2)),
                part1CorrectCount,
                part2Score: Number(part2Score.toFixed(2)),
                part2Details,
                part3Score: Number(part3Score.toFixed(2)),
                part3CorrectCount,
                totalScore
            };
        }

        // --- Submit Exam Modals & Actions ---
        window.openSubmitConfirmModal = function() {
            if (examSubmitted) {
                document.getElementById('score-report-modal').classList.remove('hidden');
                document.getElementById('score-report-modal').classList.add('flex');
                return;
            }
            const done = countTotalAnswered();
            const total = examQuestions.length;
            const summaryEl = document.getElementById('submit-confirm-summary');

            if (done < total) {
                summaryEl.innerHTML = `Bạn mới hoàn thành <strong class="text-amber-400">${done}/${total}</strong> câu hỏi (còn <strong class="text-rose-400">${total - done}</strong> câu chưa làm). Bạn có chắc chắn muốn nộp bài ngay không?`;
            } else {
                summaryEl.innerHTML = `Bạn đã hoàn thành đầy đủ <strong class="text-emerald-400">${done}/${total}</strong> câu hỏi. Nhấn xác nhận để nộp bài và nhận điểm ngay!`;
            }

            const modal = document.getElementById('submit-confirm-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        };

        window.closeSubmitConfirmModal = function() {
            const modal = document.getElementById('submit-confirm-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        window.finalizeExamSubmission = async function() {
            closeSubmitConfirmModal();
            if (examSubmitted) return;

            examSubmitted = true;
            solutionsUnlocked = true;
            if (timerInterval) clearInterval(timerInterval);

            // Unlock UI Icons
            document.getElementById('solution-lock-icon').className = 'fa-solid fa-unlock text-emerald-400';
            document.getElementById('btn-header-submit').innerHTML = `<i class="fa-solid fa-chart-pie text-emerald-400"></i><span>Xem Điểm Số</span>`;

            const grades = calculateExamGrades();
            const timeSpentSeconds = (45 * 60) - remainingSeconds;
            const spentMins = Math.floor(timeSpentSeconds / 60);
            const spentSecs = timeSpentSeconds % 60;
            const durationFormatted = `${spentMins}p ${spentSecs}s`;
            const nowStr = new Date().toLocaleString('vi-VN');

            // Populate Score Modal
            document.getElementById('result-student-info').textContent = `Thí sinh: ${studentInfo.name || 'Học sinh'} • Lớp: ${studentInfo.className || '--'} • Thời gian làm: ${durationFormatted}`;
            document.getElementById('result-total-score').textContent = grades.totalScore.toFixed(2);
            document.getElementById('result-part1-score').textContent = `${grades.part1Score.toFixed(2)} / 6.0đ`;
            document.getElementById('result-part1-detail').textContent = `Đúng ${grades.part1CorrectCount}/12 câu`;
            document.getElementById('result-part2-score').textContent = `${grades.part2Score.toFixed(2)} / 2.0đ`;
            document.getElementById('result-part2-detail').textContent = grades.part2Details.join(' | ');
            document.getElementById('result-part3-score').textContent = `${grades.part3Score.toFixed(2)} / 2.0đ`;
            document.getElementById('result-part3-detail').textContent = `Đúng ${grades.part3CorrectCount}/4 câu`;

            // Save to Cloud for Teacher
            const submissionRecord = {
                studentName: studentInfo.name || "Học sinh ẩn danh",
                className: studentInfo.className || "11",
                part1Score: grades.part1Score,
                part2Score: grades.part2Score,
                part3Score: grades.part3Score,
                totalScore: grades.totalScore,
                durationText: durationFormatted,
                submittedAt: nowStr,
                timestamp: Date.now()
            };

            await saveSubmissionToCloud(submissionRecord);

            renderQuestion(currentIdx);

            // Show Score Report Modal
            const reportModal = document.getElementById('score-report-modal');
            reportModal.classList.remove('hidden');
            reportModal.classList.add('flex');
        };

        window.closeScoreReportModal = function() {
            const reportModal = document.getElementById('score-report-modal');
            reportModal.classList.add('hidden');
            reportModal.classList.remove('flex');
        };

        window.handleSolutionClick = function() {
            if (!examSubmitted) {
                showToast("Hãy nộp bài trước để mở khóa toàn bộ lời giải chi tiết!");
                return;
            }
            solutionsUnlocked = !solutionsUnlocked;
            renderQuestion(currentIdx);
        };

        // --- Teacher Dashboard Logic ---
        window.openTeacherDashboard = function() {
            renderTeacherTable();
            const modal = document.getElementById('teacher-dashboard-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        };

        window.closeTeacherDashboard = function() {
            const modal = document.getElementById('teacher-dashboard-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        window.renderTeacherTable = function() {
            const tbody = document.getElementById('teacher-submissions-tbody');
            const filterText = (document.getElementById('filter-class-input')?.value || '').trim().toLowerCase();

            const filtered = allSubmissions.filter(item => {
                if (!filterText) return true;
                return (item.studentName || '').toLowerCase().includes(filterText) ||
                       (item.className || '').toLowerCase().includes(filterText);
            });

            document.getElementById('stat-total-count').textContent = filtered.length;
            if (filtered.length > 0) {
                const sum = filtered.reduce((acc, r) => acc + Number(r.totalScore || 0), 0);
                const max = Math.max(...filtered.map(r => Number(r.totalScore || 0)));
                document.getElementById('stat-avg-score').textContent = (sum / filtered.length).toFixed(2);
                document.getElementById('stat-max-score').textContent = max.toFixed(2);
            } else {
                document.getElementById('stat-avg-score').textContent = "0.00";
                document.getElementById('stat-max-score').textContent = "0.00";
            }

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center text-slate-500">Chưa có dữ liệu học sinh nộp bài phù hợp.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((item, idx) => `
                <tr class="hover:bg-slate-800/50 transition">
                    <td class="py-3 px-4 font-bold text-slate-400">${idx + 1}</td>
                    <td class="py-3 px-4 font-bold text-white">${escapeHtml(item.studentName)}</td>
                    <td class="py-3 px-4">
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-indigo-950 text-indigo-300 border border-indigo-700/60">
                            ${escapeHtml(item.className)}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-center text-slate-300">${Number(item.part1Score || 0).toFixed(2)}</td>
                    <td class="py-3 px-4 text-center text-slate-300">${Number(item.part2Score || 0).toFixed(2)}</td>
                    <td class="py-3 px-4 text-center text-slate-300">${Number(item.part3Score || 0).toFixed(2)}</td>
                    <td class="py-3 px-4 text-center">
                        <span class="px-2.5 py-1 rounded-lg font-extrabold text-amber-300 bg-amber-500/15 border border-amber-500/30">
                            ${Number(item.totalScore || 0).toFixed(2)}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-center text-slate-400">${escapeHtml(item.durationText || '--')}</td>
                    <td class="py-3 px-4 text-right text-slate-400">${escapeHtml(item.submittedAt || '--')}</td>
                </tr>
            `).join('');
        };

        window.exportSubmissionsCSV = function() {
            if (allSubmissions.length === 0) {
                showToast("Chưa có học sinh nào nộp bài để xuất file!");
                return;
            }
            const headers = ["STT", "Ho va Ten", "Lop", "Diem Phan I (6d)", "Diem Phan II (2d)", "Diem Phan III (2d)", "Tong Diem (10d)", "Thoi gian lam", "Thoi diem nop"];
            const rows = allSubmissions.map((s, i) => [
                i + 1,
                `"${(s.studentName || '').replace(/"/g, '""')}"`,
                `"${(s.className || '').replace(/"/g, '""')}"`,
                s.part1Score,
                s.part2Score,
                s.part3Score,
                s.totalScore,
                `"${s.durationText || ''}"`,
                `"${s.submittedAt || ''}"`
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `Ket_Qua_On_Tap_Toan_11_De04.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        };

        // --- Utilities ---
        window.toggleTheme = function() {
            document.body.classList.toggle('theme-light');
            const isLight = document.body.classList.contains('theme-light');
            document.getElementById('theme-label').textContent = isLight ? 'Light' : 'Cyber';
        };

        function showToast(msg) {
            const box = document.getElementById('toast-box');
            document.getElementById('toast-message').textContent = msg;
            box.classList.remove('hidden');
            box.classList.add('flex');
            setTimeout(() => {
                box.classList.add('hidden');
                box.classList.remove('flex');
            }, 3500);
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // --- Initialize on DOM Ready ---
        window.addEventListener('DOMContentLoaded', () => {
            shuffleQuestionsByPart();
            buildPalette();
            renderQuestion(0);
            initFirebase();
        });
    </script>
</body>
</html>