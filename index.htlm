        const TABLE_PART2_Q2 = `
            <table class="math-table">
                <thead>
                    <tr>
                        <th>Cân nặng (gam)</th>
                        <th>$[150; 155)$</th>
                        <th>$[155; 160)$</th>
                        <th>$[160; 165)$</th>
                        <th>$[165; 170)$</th>
                        <th>$[170; 175)$</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="font-semibold text-indigo-200">Số quả cam lô A</td>
